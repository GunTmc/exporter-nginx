# Salin ke /etc/default/nginxlogreport dan sesuaikan. Dibaca oleh deploy/nginxlogreport-daily.sh.
# Izin yang disarankan: chmod 640 /etc/default/nginxlogreport

# Wajib: folder access log nginx
LOG_DIR=/var/log/nginx

# Folder keluaran laporan (jangan di dalam folder yang disajikan web server)
REPORT_DIR=/var/reports/nginx

# Awalan nama file log (access-YYYY-MM-DD.log). Nginx default TIDAK menamai log per tanggal
# (logrotate biasa menghasilkan access.log.1.gz) — konfigurasi logrotate dengan:
#   dateext
#   dateformat -%Y-%m-%d
# supaya nama file jadi access-2026-09-20.log.gz, sesuai yang dicari script ini.
LOG_PREFIX=access

# yesterday (disarankan, dijalankan sesudah tengah malam) atau tanggal tetap YYYY-MM-DD
REPORT_DATE=yesterday

# Status code minimum yang disimpan ke laporan. 0 = semua request (traffic harian penuh).
# Isi 400 bila hanya ingin laporan error harian.
STATUS=0

# 1 = samarkan email, NIK, nomor HP, token yang nyasar ke query string/referer/User-Agent
MASK=1

# Izin file laporan. 640 bila grup tertentu perlu membaca.
REPORT_MODE=600

# Hapus laporan lebih tua dari sekian hari (0 = jangan hapus)
RETENTION_DAYS=30

# Executable Bun: nama di PATH atau path lengkap. Unit systemd memakai ProtectHome=yes,
# jadi pasang Bun di lokasi yang bisa dibaca user nginxlogreport (mis. /usr/local/bin/bun), bukan di ~/.bun.
RUNTIME=bun

# Opsi tambahan untuk nginxlogreport, dipisah spasi
NGINXLOGREPORT_ARGS=
